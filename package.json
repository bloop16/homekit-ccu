{
	"name": "homekit-ccu",
	"version": "0.1.0-rc.3",
	"description": "provides a homekit bridge to the ccu",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bloop16/homekit-ccu.git"
	},
	"keywords": [
		"HomeKit",
		"HomeMatic",
		"CCU"
	],
	"engines": {
		"node": ">=22.0.0"
	},
	"dependencies": {
		"@homebridge/hap-nodejs": "^2.2.3",
		"binrpc": "^4.3.0",
		"chalk": "^4.0.0",
		"commander": "^14.0.3",
		"formidable": "^3.5.4",
		"homematic-xmlrpc": "^2.0.0",
		"sockjs": "^0.3.20"
	},
	"bundleDependencies": [
		"@homebridge/hap-nodejs",
		"binrpc",
		"chalk",
		"commander",
		"formidable",
		"homematic-xmlrpc",
		"sockjs"
	],
	"scripts": {
		"start": "node index.js || true",
		"dev": "node index.js -D || true",
		"devall": "DEBUG=* node index.js -D || true",
		"test": "mocha",
		"lint": "standard",
		"coverage": "c8 --include 'lib/services/camera/**' --include lib/services/CustomHomeKitTypes.js --include lib/util/time.js --include lib/util/hapIds.js --include lib/util/instanceMigration.js --include lib/util/configMigration.js --include lib/util/mappingInstances.js --include lib/monitConfig.js --check-coverage --lines 80 mocha"
	},
	"overrides": {
		"sockjs": {
			"uuid": "^11.1.1"
		}
	},
	"devDependencies": {
		"c8": "^12.0.0",
		"expect.js": "0.3.1",
		"mocha": "^12.0.2",
		"standard": "^17.1.2"
	},
	"mocha": {
		"bail": true,
		"exit": true,
		"reporter": "spec",
		"recursive": true
	},
	"standard": {
		"ignore": [
			"/lib/configurationsrv/html/*",
			"/lib/vendor/**"
		],
		"env": [
			"commonjs",
			"node",
			"mocha"
		]
	},
	"files": [
		"lib/",
		"etc/",
		"README.md",
		"CHANGELOG.md",
		"LICENSE",
		"index.js",
		"package.json",
		".nobackup"
	]
}
