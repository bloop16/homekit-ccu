{
	"name": "homekit-ccu",
	"version": "0.1.1",
	"description": "Apple HomeKit bridge for HomeMatic and HomematicIP devices, running as an add-on on OpenCCU",
	"author": "bloop16 (https://github.com/bloop16)",
	"contributors": [
		"Thomas Kluge (https://github.com/thkl)",
		"Jochen Britz (https://github.com/Britz)"
	],
	"homepage": "https://github.com/bloop16/homekit-ccu#readme",
	"bugs": {
		"url": "https://github.com/bloop16/homekit-ccu/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bloop16/homekit-ccu.git"
	},
	"keywords": [
		"homekit",
		"homematic",
		"homematic-ip",
		"openccu",
		"ccu",
		"hap",
		"smarthome"
	],
	"engines": {
		"node": ">=22.12.0"
	},
	"dependencies": {
		"@homebridge/hap-nodejs": "^2.2.3",
		"binrpc": "^4.3.0",
		"commander": "^15.0.0",
		"formidable": "^3.5.4",
		"homematic-xmlrpc": "^2.0.0"
	},
	"bundleDependencies": [
		"@homebridge/hap-nodejs",
		"binrpc",
		"commander",
		"formidable",
		"homematic-xmlrpc"
	],
	"scripts": {
		"start": "node index.js || true",
		"dev": "node index.js -D || true",
		"devall": "DEBUG=* node index.js -D || true",
		"test": "mocha",
		"lint": "eslint .",
		"coverage": "c8 --include 'lib/services/camera/**' --include lib/services/CustomHomeKitTypes.js --include lib/util/time.js --include lib/util/hapIds.js --include lib/util/instanceMigration.js --include lib/util/configMigration.js --include lib/util/mappingInstances.js --include lib/monitConfig.js --check-coverage --lines 80 mocha"
	},
	"devDependencies": {
		"c8": "^12.0.0",
		"eslint": "^9.39.5",
		"expect.js": "0.3.1",
		"globals": "^17.12.0",
		"mocha": "^12.0.2",
		"neostandard": "^0.13.0"
	},
	"mocha": {
		"bail": true,
		"exit": true,
		"reporter": "spec",
		"recursive": true
	},
	"files": [
		"lib/",
		"etc/",
		"README.md",
		"CHANGELOG.md",
		"LICENSE",
		"index.js",
		"package.json",
		".nobackup"
	]
}
