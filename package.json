{
	"name": "homekit-ccu",
	"version": "0.1.0-dev",
	"description": "provides a homekit bridge to the ccu",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git://github.com/britz/homekit-ccu.git"
	},
	"keywords": [
		"HomeKit",
		"HomeMatic",
		"CCU"
	],
	"engines": {
		"node": ">=22.0.0"
	},
	"dependencies": {
		"@homebridge/hap-nodejs": "^2.2.3",
		"binrpc": "3.3.1",
		"chalk": "^4.0.0",
		"commander": "^14.0.3",
		"fakegato-history": "^0.6.7",
		"formidable": "^3.5.4",
		"homematic-xmlrpc": "1.0.2",
		"sockjs": "^0.3.20"
	},
	"scripts": {
		"start": "node index.js || true",
		"dev": "node index.js -D || true",
		"devall": "DEBUG=* node index.js -D || true",
		"test": "mocha",
		"lint": "standard",
		"coverage": "c8 --include 'lib/services/camera/**' --include lib/services/CustomHomeKitTypes.js --include lib/util/time.js --check-coverage --lines 80 mocha"
	},
	"overrides": {
		"serialize-javascript": "7.0.5",
		"mocha": {
			"diff": "^8.0.3"
		},
		"sockjs": {
			"uuid": "^11.1.1"
		}
	},
	"devDependencies": {
		"c8": "^10.1.3",
		"expect.js": "0.3.1",
		"mocha": "^11.3.0",
		"standard": "^17.1.2"
	},
	"mocha": {
		"bail": true,
		"reporter": "spec",
		"recursive": true
	},
	"standard": {
		"ignore": [
			"/lib/configurationsrv/html/*"
		],
		"env": [
			"commonjs",
			"node",
			"mocha"
		]
	},
	"files": [
		"lib/",
		"etc/",
		"README.md",
		"CHANGELOG.md",
		"LICENSE",
		"index.js",
		"package.json",
		".nobackup"
	]
}
