#!/bin/sh
ADDON_NAME=homekit-ccu
ADDON_DIR=/usr/local/addons/${ADDON_NAME}
MODULE_DIR=${ADDON_DIR}/node_modules/${ADDON_NAME}
CONFIG_URL=/addons/${ADDON_NAME}/index.html
CONFIG_DIR=/usr/local/etc/config
ADDONCFG_DIR=${CONFIG_DIR}/addons/${ADDON_NAME}
ADDONWWW_DIR=${CONFIG_DIR}/addons/www/${ADDON_NAME}
NPMCACHE_DIR=/tmp/homekit-ccu-cache
RCD_DIR=${CONFIG_DIR}/rc.d
PIDFILE=/var/run/homekit-ccu.pid
VER=0.1.1-rc.3
REQUIRED_MAJOR=22
LOGFILE=/var/log/homekit-ccu.log
LOCKFILE=/var/run/homekit-ccu-install.lock
LIGHTTPD_CONF_DIR=/etc/config/lighttpd
MONIT_DIR=/usr/local/etc
MONIT_BIN=/usr/bin/monit
HM_ADDONS_CFG=/etc/config/hm_addons.cfg
# leftovers of hap-homematic, the name of this addon before the rename. update_script refuses to
# install while hap-homematic is installed; its uninstall can leave these behind. Its
# configuration directory ${CONFIG_DIR}/addons/hap-homematic is kept.
LEGACY_NAME=hap-homematic
LEGACY_MONIT_CFG=${MONIT_DIR}/monit_${LEGACY_NAME}.cfg
LEGACY_LIGHTTPD_CONF=${LIGHTTPD_CONF_DIR}/${LEGACY_NAME}.conf

# ------------------------------------------------------------------
# Helper functions
# ------------------------------------------------------------------

log() {
  local TAG="$1"; shift
  local LOGDATE="$(date '+%m/%d/%Y, %I:%M:%S %p' | sed 's|^0||;s|, 0|, |')"
  echo "[$LOGDATE] [HomeKit-CCU] [$TAG] $*" | tee -a ${LOGFILE}
  logger -t homekit-ccu -p user.info "$*"
}

usage() {
	cmds=$(grep -oE '^([a-z_]+)\(\)' "$0" | sed 's/()//g' | grep -v '^usage$\|^log$\|^check_\|^remove_\|^uninstall_' | tr '\n' '|' | sed 's/|$//')
	echo "Usage: $0 {${cmds}}" >&2
}

# ------------------------------------------------------------------
# Install functions
# ------------------------------------------------------------------

check_node_version() {
  if ! command -v node >/dev/null 2>&1; then
    log "install" "ERROR: Node.js not found in PATH"
    return 1
  fi

  CURRENT_VERSION=$(node --version 2>/dev/null)
  if [ -z "${CURRENT_VERSION}" ]; then
    log "install" "ERROR: Node.js found but could not determine version"
    return 1
  fi

  CURRENT_MAJOR=$(echo "${CURRENT_VERSION}" | sed 's/^v//' | cut -d. -f1)

  if [ "${CURRENT_MAJOR}" -ge "${REQUIRED_MAJOR}" ] 2>/dev/null; then
    log "install" "Node.js ${CURRENT_VERSION} meets requirement (>=${REQUIRED_MAJOR})"
    return 0
  else
    log "install" "ERROR: Node.js ${CURRENT_VERSION} is too old (need >=${REQUIRED_MAJOR}). Update OpenCCU to 3.89 or newer."
    return 1
  fi
}

# Remove what an uninstalled hap-homematic left behind: its monit config defines the same
# service (every "monit reload" fails with "Service name conflict"), its lighttpd config and its
# WebUI button. Needs ${MODULE_DIR}/etc/hm_addon.js, so it runs after the npm install.
remove_legacy_hap_homematic() {
  if [ -f "${LEGACY_MONIT_CFG}" ]; then
    log "install" "Removing legacy monit config ${LEGACY_MONIT_CFG}."
    rm -f "${LEGACY_MONIT_CFG}"
    if [ -x "${MONIT_BIN}" ]; then
      "${MONIT_BIN}" reload >> ${LOGFILE} 2>&1 || log "install" "monit reload failed, continuing."
    fi
  fi
  if [ -f "${LEGACY_LIGHTTPD_CONF}" ]; then
    log "install" "Removing legacy lighttpd config ${LEGACY_LIGHTTPD_CONF}."
    rm -f "${LEGACY_LIGHTTPD_CONF}"
  fi
  if [ -f "${HM_ADDONS_CFG}" ] && grep -q "${LEGACY_NAME} {" "${HM_ADDONS_CFG}"; then
    log "install" "Removing legacy WebUI button ${LEGACY_NAME}."
    node "${MODULE_DIR}/etc/hm_addon.js" ${LEGACY_NAME} >> ${LOGFILE} 2>&1 || log "install" "Legacy WebUI button removal failed, continuing."
  fi
}

install() {
  check_node_version || return 1

  if [ -f ${MODULE_DIR}/index.js ]; then
    log "install" "Existing installation found, removing package first..."
    uninstall_server
  fi
  # always start from an empty directory: a half-installed one (package-lock.json without
  # index.js) makes every later offline npm install fail with ENOTCACHED
  rm -rf "${ADDON_DIR}"

  log "install" "Starting install"
  log "install" "Running on node version: $(node --version)"
  log "install" "NPM is: $(npm --version)"
  log "install" "Program Dir is ${ADDON_DIR}"
  log "install" "Installing HomeKit-CCU."
  
  mkdir -p ${ADDON_DIR}
  chmod 755 ${ADDON_DIR}
  cd ${ADDON_DIR} || { log "install" "ERROR: cannot enter ${ADDON_DIR}"; return 1; }
  
  # a fresh cache only root can use: an existing path (e.g. a symlink planted in /tmp) is removed first
  rm -rf ${NPMCACHE_DIR}
  mkdir -m 700 ${NPMCACHE_DIR} || { log "install" "ERROR: cannot create ${NPMCACHE_DIR}"; return 1; }
  log "install" "Installing Node.JS packages from \"${ADDONCFG_DIR}/etc/homekit-ccu.tgz\"." 
  # all dependencies are bundled in the tgz, npm must not touch the registry
  npm i --offline --no-audit --no-fund --cache ${NPMCACHE_DIR} ${ADDONCFG_DIR}/etc/homekit-ccu.tgz >> ${LOGFILE} 2>&1 || {
    rm -rf ${NPMCACHE_DIR}
    log "install" "ERROR: npm install failed, see ${LOGFILE}"
    return 1
  }
  rm -rf ${NPMCACHE_DIR}
  [ -f "${MODULE_DIR}/index.js" ] || {
    log "install" "ERROR: npm install left no ${MODULE_DIR}/index.js, see ${LOGFILE}"
    return 1
  }

  remove_legacy_hap_homematic

  log "install" "Installing WebUI files."
  mkdir -p ${ADDONWWW_DIR}
  # without -a: the files get the time of the installation. npm packs every file with the same
  # time in 1985, so browsers would take the pages of the last version as years old and fresh.
  cp -Rf ${MODULE_DIR}/lib/configurationsrv/html/* ${ADDONWWW_DIR}

  log "install" "Installing lighttpd config."
  mkdir -p ${LIGHTTPD_CONF_DIR}
  cp -af ${MODULE_DIR}/etc/homekit_ccu.conf ${LIGHTTPD_CONF_DIR}/${ADDON_NAME}.conf
  killall lighttpd 2>/dev/null; sleep 1; lighttpd -f /etc/lighttpd/lighttpd.conf

  log "install" "Creating HomeKit Button."
  node "${MODULE_DIR}/etc/hm_addon.js" homekit-ccu ${MODULE_DIR}/etc/homekit_ccu_addon.cfg >> ${LOGFILE} 2>&1

  log "install" "Adding .nobackup to addon dir."
  touch ${ADDON_DIR}/.nobackup

  # older versions opened the ports 9874/49874 for the configuration; it now goes through the
  # WebUI (lighttpd), so close them again (TCL library, persists through WebUI saves)
  if [ -f /lib/libfirewall.tcl ]; then
    tclsh - <<'EOF'
source /lib/libfirewall.tcl
Firewall_loadConfiguration
global Firewall_USER_PORTS
foreach port {9874 49874} {
  set idx [lsearch $Firewall_USER_PORTS $port]
  if {$idx != -1} {
    set Firewall_USER_PORTS [lreplace $Firewall_USER_PORTS $idx $idx]
  }
}
Firewall_saveConfiguration
Firewall_configureFirewall
EOF
  fi

  log "install" "Installation complete."
}

background_install() {
  exec 9>"$LOCKFILE"
  if ! flock -n 9; then
    log "install" "ERROR: Installation already running, aborting."
    return 1
  fi
  # Check before anything is removed: on an unsupported CCU the old installation stays usable
  check_node_version || return 1
  # Remove button during install so the CCU WebUI doesn't show a broken link
  if [ -f ${MODULE_DIR}/etc/hm_addon.js ]; then
    node "${MODULE_DIR}/etc/hm_addon.js" homekit-ccu >> ${LOGFILE} 2>&1
  fi
  log "install" "Running install and start in background"
  (
    if install; then
      start
    else
      log "install" "ERROR: installation failed, HomeKit-CCU was not started"
    fi
    flock -u 9 >>${LOGFILE} 2>&1
  ) >/dev/null 2>&1 &
}

# ------------------------------------------------------------------
# Uninstall functions
# ------------------------------------------------------------------

# Uninstall all configurations
uninstall_config() {
  #remove_addon_config
  log "uninstall" "Removing addon config."
  rm -rf ${ADDONCFG_DIR}

  # remove_lighttpd_config
  log "uninstall" "Removing lighttpd config and reloading."
  rm -f ${LIGHTTPD_CONF_DIR}/${ADDON_NAME}.conf
  killall lighttpd 2>/dev/null; sleep 1; lighttpd -f /etc/lighttpd/lighttpd.conf

  # remove_firewall_ports
  if [ -f /lib/libfirewall.tcl ]; then
    log "uninstall" "Removing firewall ports."
    tclsh - <<'EOF'
source /lib/libfirewall.tcl
Firewall_loadConfiguration
global Firewall_USER_PORTS
foreach port {9874 49874} {
  set idx [lsearch $Firewall_USER_PORTS $port]
  if {$idx != -1} {
    set Firewall_USER_PORTS [lreplace $Firewall_USER_PORTS $idx $idx]
  }
}
Firewall_saveConfiguration
Firewall_configureFirewall
EOF
  fi

  # remove_monit_config
  if [ -f ${MONIT_DIR}/monit_${ADDON_NAME}.cfg ]; then
    log "uninstall" "Removing monit config."
    rm ${MONIT_DIR}/monit_${ADDON_NAME}.cfg
    ${MONIT_BIN} reload
  fi
  log "uninstall" "Config removal complete."
}

# Uninstall programm componente keeping the config (for reinstall)
uninstall_server() {
  stop
   # remove WebUI button
  if [ -f ${MODULE_DIR}/etc/hm_addon.js ]; then
    log "uninstall" "Removing WebUI button."
    node "${MODULE_DIR}/etc/hm_addon.js" homekit-ccu >> ${LOGFILE} 2>&1
  fi

  # remove addon directory
  log "uninstall" "Removing addon directory."
  rm -rf ${ADDON_DIR}/

  # remove www_files
  log "uninstall" "Removing www files."
  rm -rf ${ADDONWWW_DIR}

  # remove npm cache if left over from interrupted install
  rm -rf ${NPMCACHE_DIR}

  log "uninstall" "Server removal complete."
}

# Uninstall rc.d script
uninstall_daemon() {
  log "uninstall" "Removing rc.d script."
  rm -f ${RCD_DIR}/${ADDON_NAME}
}

# Full Uninstall
uninstall() {
  log "uninstall" "Removing HomeKit-CCU."
  uninstall_server
  uninstall_config
  uninstall_daemon
  log "uninstall" "Uninstall complete."
}

# ------------------------------------------------------------------
# Daemon functions required by CCU
# ------------------------------------------------------------------

start_debug() {
	log "start" "Starting HomeKit-CCU."
	start-stop-daemon --start --quiet --oknodo --make-pidfile --background --pidfile $PIDFILE --startas "node" -- "$MODULE_DIR/index.js" "-D"
	log "start" "HomeKit-CCU started, log may be found at ${LOGFILE}."
}

start() {
	log "start" "Starting HomeKit-CCU."
	start-stop-daemon --start --quiet --oknodo --make-pidfile --background --pidfile $PIDFILE --startas "node" -- "$MODULE_DIR/index.js"
	log "start" "HomeKit-CCU started, log may be found at ${LOGFILE}."
}

stop() {
	log "stop" "Stopping HomeKit-CCU."
    start-stop-daemon --stop --quiet --oknodo --retry 5 --pidfile $PIDFILE
    if [ -e $PIDFILE ];then
	  log "stop" "Removing PIDFILE: $PIDFILE."
      rm -f $PIDFILE
    fi
	sleep 2
	# only the server and its configuration process, both run from the module directory
	pgrep -f "node .*${MODULE_DIR}/" | xargs -r kill -9 2>/dev/null
 	log "stop" "HomeKit-CCU stopped."
}

restart() {
	log "restart" "Performing a HomeKit-CCU start & stop cycle"
	stop
	log "restart" "Wating a short time before restart"
	sleep 10
	start
}

status() {
	if ! flock -n 9 9>"$LOCKFILE" 2>/dev/null; then
		echo "install: running"
	elif [ -f ${MODULE_DIR}/index.js ]; then
		echo "install: complete"
	else
		echo "install: not installed"
	fi
	if [ -f $PIDFILE ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null; then
		echo "server: running (PID $(cat $PIDFILE))"
	else
		echo "server: stopped"
	fi
}

info() {
	INFO_HTML="<center><b>HomeKit-CCU</b><p style='margin-top: 5px;margin-bottom: 5px;'><img src='../addons/homekit-ccu/homekit-ccu-logo.png'></p></center>"

	if ! flock -n 9 9>"$LOCKFILE" 2>/dev/null; then
		INFO_HTML="${INFO_HTML}<br /><b style='color:orange;'>Installation in progress...</b>"
		OPS=""
	elif [ -f $PIDFILE ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null; then
		INFO_HTML="${INFO_HTML}HomeMatic/HomeMatic IP goes Apple Homekit"
		OPS="uninstall stop restart"
	else
		INFO_HTML="${INFO_HTML}<b style='color:red;'>Server stopped</b>"
		OPS="uninstall start"
	fi

	INFO_HTML="${INFO_HTML}<br />Node.js $(node --version 2>/dev/null || echo 'missing')"
	INFO_HTML="${INFO_HTML}<br /><a href='https://github.com/bloop16/homekit-ccu/'>https://github.com/bloop16/homekit-ccu/</a>"

	echo "Info: ${INFO_HTML}"
	echo "Name: HomeKit-CCU"
	echo "Version: $VER"
	echo "Operations: ${OPS}"
	[ -n "${OPS}" ] && echo "Config-Url: $CONFIG_URL"
	echo "Update: /addons/${ADDON_NAME}/update-check.cgi"
}

# ------------------------------------------------------------------
# Runtime logic
# ------------------------------------------------------------------

CMD="${1:-start}"
if type "$CMD" 2>/dev/null | grep -q 'function'; then
  "$CMD"
else
  usage
  exit 1
fi
