#!/bin/sh

ADDONNAME=homekit-ccu
CONFIG_DIR=/usr/local/etc/config
ADDONS_DIR=/usr/local/addons
ADDONCFG_DIR=${CONFIG_DIR}/addons/${ADDONNAME}
RCD_DIR=${CONFIG_DIR}/rc.d
REQUIRED_NODE_MAJOR=22

fail() {
  echo "ERROR: $*" >&2
  exit 1
}

# only OpenCCU is supported; it identifies itself as HM-RASPBERRYMATIC
if [ "$1" != "HM-RASPBERRYMATIC" ]; then
  fail "unsupported platform '$1'. HomeKit-CCU needs OpenCCU 3.89 or newer."
fi

# check Node.js before anything is copied, so a failed check leaves no half-installed addon
NODE_VERSION=$(node --version 2>/dev/null)
if [ -z "${NODE_VERSION}" ]; then
  fail "Node.js not found. HomeKit-CCU needs Node.js ${REQUIRED_NODE_MAJOR} or newer (OpenCCU 3.89 or newer)."
fi
NODE_MAJOR=$(echo "${NODE_VERSION}" | sed 's/^v//' | cut -d. -f1)
if ! [ "${NODE_MAJOR}" -ge "${REQUIRED_NODE_MAJOR}" ] 2>/dev/null; then
  fail "Node.js ${NODE_VERSION} is too old. HomeKit-CCU needs Node.js ${REQUIRED_NODE_MAJOR} or newer, update to OpenCCU 3.89 or newer."
fi

# hap-homematic has to be removed first: it runs the same kind of bridges and its backup is
# how configuration and HomeKit pairing come over
if [ -e "${RCD_DIR}/hap-homematic" ] || [ -d "${ADDONS_DIR}/hap-homematic" ]; then
  fail "hap-homematic is still installed. Create a backup in hap-homematic (Internals > Backup), uninstall hap-homematic under Settings > Control panel > Additional software, then install HomeKit-CCU and restore the backup in its configuration (Internals > Backup)."
fi

# create necessary directories
mkdir -p "${RCD_DIR}" "${ADDONCFG_DIR}/etc" || fail "unable to create ${RCD_DIR} and ${ADDONCFG_DIR}/etc"

# copy rc.d script (contains install, uninstall, start, stop, etc.)
cp -af homekit-ccu "${RCD_DIR}" || fail "unable to copy the rc.d script to ${RCD_DIR}"

# copy the npm package so the install function can install from it
cp -af homekit-ccu.tgz "${ADDONCFG_DIR}/etc/homekit-ccu.tgz" || fail "unable to copy homekit-ccu.tgz to ${ADDONCFG_DIR}/etc"

# fix permissions
chmod 755 "${RCD_DIR}"
chmod +x "${RCD_DIR}/${ADDONNAME}"

# Run install + start in background so the CCU WebUI popup returns immediately.
# The heavy npm install can take a while — if update_script blocks, the UI times out.
"${RCD_DIR}/${ADDONNAME}" background_install &
exit 0
